UNMESS_ENV=development
UNMESS_LOG_LEVEL=INFO
UNMESS_API_HOST=0.0.0.0
UNMESS_API_PORT=8000
UNMESS_REDIS_URL=redis://redis:6379/0
UNMESS_QDRANT_URL=http://qdrant:6333
UNMESS_QDRANT_COLLECTION=unmess_chunks
UNMESS_OLLAMA_URL=http://host.docker.internal:11434
UNMESS_TEXT_MODEL=qwen3
UNMESS_VISION_MODEL=qwen2.5vl
UNMESS_DOCLING_ARTIFACTS_PATH=~/.cache/docling/models
UNMESS_EMBED_MODEL=bge-m3
UNMESS_RERANK_ENABLED=false
UNMESS_PARSER_TEXT_DENSITY_THRESHOLD=0.12
UNMESS_PARSER_IMAGE_COVERAGE_THRESHOLD=0.70
UNMESS_PARSER_TABLE_LIKELIHOOD_THRESHOLD=0.55
UNMESS_PARSER_SCAN_LIKELIHOOD_THRESHOLD=0.60
UNMESS_PARSER_COMPLEX_LAYOUT_THRESHOLD=0.90
UNMESS_PARSER_UNCOVERED_INK_THRESHOLD=0.05
UNMESS_PARSER_GARBLED_RATIO_THRESHOLD=0.10
UNMESS_PARSER_MAX_SKEW_DEGREES=3.0
UNMESS_QUALITY_REVIEW_THRESHOLD=0.70
UNMESS_QUALITY_VISUAL_NOISE_THRESHOLD=0.85
UNMESS_VISION_TIMEOUT_S=120.0
UNMESS_VISION_RETRIES=1
UNMESS_VISION_RASTER_DPI=110
UNMESS_VISION_TEMPERATURE=0.1
UNMESS_VISION_REPEAT_PENALTY=1.1
UNMESS_VISION_REPEAT_LAST_N=64
UNMESS_VISION_NUM_PREDICT=2048
UNMESS_VISION_CACHE_DIR=.cache/unmess/vlm
UNMESS_VISION_CACHE_READS=true
UNMESS_CHUNK_TARGET_TOKENS=600
UNMESS_CHUNK_OVERLAP_TOKENS=80
